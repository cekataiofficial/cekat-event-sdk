{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cekat.ai/event-sdk/release/compatibility-matrix.schema.json",
  "title": "Cekat event SDK compatibility matrix",
  "description": "ci/compatibility-matrix.json. This schema documents the shape; scripts/validate-compatibility-matrix.py is the executable authority and also checks the values against package metadata, ci.yml, release-readiness.yml, and each language's evidence document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verified_on", "languages"],
  "properties": {
    "schema_version": { "const": 1 },
    "verified_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "languages": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        { "$ref": "#/$defs/language", "properties": { "language": { "const": "go" } } },
        { "$ref": "#/$defs/language", "properties": { "language": { "const": "node" } } },
        { "$ref": "#/$defs/language", "properties": { "language": { "const": "python" } } },
        { "$ref": "#/$defs/language", "properties": { "language": { "const": "php" } } },
        { "$ref": "#/$defs/language", "properties": { "language": { "const": "java" } } },
        { "$ref": "#/$defs/language", "properties": { "language": { "const": "dotnet" } } },
        { "$ref": "#/$defs/language", "properties": { "language": { "const": "ruby" } } }
      ],
      "items": false
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\]+$" },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "evidence", "runtimes", "ci", "profiles", "release_readiness", "frameworks", "end_of_support"],
      "properties": {
        "language": { "enum": ["go", "node", "python", "php", "java", "dotnet", "ruby"] },
        "evidence": { "$ref": "#/$defs/path" },
        "runtimes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "declared", "declared_in"],
            "properties": {
              "name": { "$ref": "#/$defs/text" },
              "declared": { "$ref": "#/$defs/text" },
              "declared_in": {
                "type": "object",
                "additionalProperties": false,
                "required": ["file", "kind"],
                "properties": {
                  "file": { "$ref": "#/$defs/path" },
                  "kind": { "type": "string", "pattern": "^(go-directive|requires-python|npm-engine:.+|composer-require:.+|maven-property:.+|msbuild-property:.+|gemspec:.+)$" }
                }
              }
            }
          }
        },
        "ci": {
          "type": "array",
          "minItems": 1,
          "description": "The first entry holds the runtime versions that profiles refer to.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["job", "key", "values"],
            "properties": {
              "job": { "$ref": "#/$defs/text" },
              "key": { "$ref": "#/$defs/text" },
              "values": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }
            }
          }
        },
        "profiles": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/profile", "properties": { "name": { "const": "minimum" } } },
            { "$ref": "#/$defs/profile", "properties": { "name": { "const": "current" } } }
          ],
          "minItems": 2,
          "items": false
        },
        "release_readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "value"],
          "properties": { "key": { "$ref": "#/$defs/text" }, "value": { "$ref": "#/$defs/text" } }
        },
        "frameworks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "supported", "declared_in", "tested"],
            "properties": {
              "name": { "$ref": "#/$defs/text" },
              "supported": { "$ref": "#/$defs/text" },
              "declared_in": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["file", "contains"],
                    "properties": { "file": { "$ref": "#/$defs/path" }, "contains": { "$ref": "#/$defs/text" } }
                  }
                ]
              },
              "tested": { "type": "array", "items": { "$ref": "#/$defs/text" } }
            }
          }
        },
        "end_of_support": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "line", "date"],
            "properties": {
              "component": { "$ref": "#/$defs/text" },
              "line": { "$ref": "#/$defs/text" },
              "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" }
            }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ci_value", "observed"],
      "properties": {
        "name": { "enum": ["minimum", "current"] },
        "ci_value": { "$ref": "#/$defs/text" },
        "observed": { "type": "string", "pattern": "^v?\\d+(\\.\\d+)+$" }
      }
    }
  }
}
