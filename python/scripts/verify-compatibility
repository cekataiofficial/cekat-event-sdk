#!/usr/bin/env python3
"""Print current PyPI metadata for the supported runtime and framework lines as JSON evidence.

Review the output with the official lifecycle pages linked in docs/compatibility.md before a
release; it reads public metadata only and never publishes anything.
"""

from __future__ import annotations

import json
import platform
import sys
import urllib.request
from datetime import datetime, timezone

PACKAGES = (
    "anyio",
    "asgiref",
    "Django",
    "fastapi",
    "Flask",
    "hatchling",
    "httpx",
    "mypy",
    "pytest",
    "pytest-asyncio",
    "ruff",
    "starlette",
)


def metadata(name: str) -> dict[str, object]:
    with urllib.request.urlopen(f"https://pypi.org/pypi/{name}/json", timeout=30) as response:
        info = json.load(response)["info"]
    return {"version": info["version"], "requires_python": info["requires_python"]}


def main() -> None:
    result = {
        "schema_version": 1,
        "observed_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "executing_python": platform.python_version(),
        "sources": {
            "python": "https://devguide.python.org/versions/",
            "django": "https://www.djangoproject.com/download/#supported-versions",
            "flask": "https://flask.palletsprojects.com/en/stable/changes/",
            "pypi": "https://pypi.org/pypi/<package>/json",
        },
        "pypi": {name: metadata(name) for name in PACKAGES},
    }
    json.dump(result, sys.stdout, indent=2, sort_keys=True)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
