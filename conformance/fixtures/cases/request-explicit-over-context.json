{
  "schema_version": 1,
  "id": "request-explicit-over-context",
  "description": "A nonblank explicit event visitor takes precedence over ambient visitor state.",
  "kind": "request",
  "inbound": {
    "ambient_visitor_id": "ambient-visitor"
  },
  "operation": {
    "name": "user_login",
    "event": {
      "email": "explicit@example.com",
      "visitor_id": "explicit-visitor"
    }
  },
  "expect": {
    "result": "acknowledgement",
    "attempts": 1,
    "request": {
      "path": "/api/events/ingest",
      "authorization": "Bearer conformance-token",
      "payload": {
        "event_key": "user_login",
        "is_common": true,
        "email": "explicit@example.com",
        "visitor_id": "explicit-visitor"
      }
    }
  }
}
