{
  "schema_version": 1,
  "id": "retry-502-503-504-exhausted",
  "description": "Gateway statuses 502, 503, and 504 are retried until attempts are exhausted.",
  "kind": "retry",
  "operation": {
    "name": "order_paid",
    "event": {
      "email": "buyer@example.com",
      "properties": {
        "order_id": "ord-paid"
      }
    }
  },
  "responses": [
    {
      "status": 502,
      "body": "bad gateway"
    },
    {
      "status": 503,
      "body": "unavailable"
    },
    {
      "status": 504,
      "body": "gateway timeout"
    }
  ],
  "client": {
    "retry_count": 2
  },
  "expect": {
    "result": "api_error",
    "attempts": 3,
    "delivery_outcome_unknown": false,
    "status": 504,
    "error_message": "Gateway Timeout",
    "jitter_bounds_ms": [
      [
        0,
        100
      ],
      [
        0,
        200
      ]
    ],
    "request": {
      "path": "/api/events/ingest",
      "authorization": "Bearer conformance-token",
      "payload": {
        "event_key": "order_paid",
        "is_common": true,
        "email": "buyer@example.com",
        "properties": {
          "order_id": "ord-paid"
        }
      }
    }
  }
}
