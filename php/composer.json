{
    "name": "cekat/event-sdk",
    "description": "Submit identity-bearing Cekat events from PHP backends with automatic browser visitor correlation.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "cekat",
        "events",
        "tracking",
        "psr-15",
        "laravel",
        "symfony"
    ],
    "homepage": "https://github.com/cekataiofficial/cekat-event-sdk/tree/main/php#readme",
    "support": {
        "issues": "https://github.com/cekataiofficial/cekat-event-sdk/issues",
        "source": "https://github.com/cekataiofficial/cekat-event-sdk/tree/main/php",
        "docs": "https://github.com/cekataiofficial/cekat-event-sdk/blob/main/php/README.md"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.15.2 || ^8.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "laravel/framework": "^12.0 || ^13.0",
        "opis/json-schema": "^2.4",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.0",
        "symfony/http-foundation": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.0"
    },
    "suggest": {
        "ext-curl": "Recommended Guzzle handler; enforces the per-attempt timeout and bounded response reads efficiently.",
        "laravel/framework": "Use Cekat\\EventSdk\\Integration\\Laravel\\CekatServiceProvider and VisitorMiddleware (Laravel 12 or 13).",
        "symfony/http-kernel": "Use Cekat\\EventSdk\\Integration\\Symfony\\VisitorContextKernel (Symfony 6.4, 7.4, or 8)."
    },
    "autoload": {
        "psr-4": {
            "Cekat\\EventSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cekat\\EventSdk\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cekat\\EventSdk\\Integration\\Laravel\\CekatServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/tests",
            "/scripts",
            "/docs",
            "/vendor",
            "/composer.lock",
            "/.phpunit.cache",
            "/.php-cs-fixer.cache",
            "/phpunit.xml.dist",
            "/phpstan.neon.dist",
            "/.php-cs-fixer.dist.php",
            "/.gitignore"
        ]
    }
}
