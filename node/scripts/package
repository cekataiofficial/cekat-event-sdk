#!/usr/bin/env node
/** Creates a verified local npm archive and manifest without publishing or signing. */
import { execFileSync } from 'node:child_process';
import { createHash, randomBytes } from 'node:crypto';
import { lstat, mkdir, open, readdir, realpath, rename, rm, stat } from 'node:fs/promises';
import { dirname, isAbsolute, relative, resolve, sep } from 'node:path';
import { fileURLToPath } from 'node:url';

const VERSION = '0.1.0';
const projectRoot = resolve(fileURLToPath(new URL('..', import.meta.url)));

function usage(message) {
  if (message) process.stderr.write(`${message}\n`);
  process.stderr.write('usage: scripts/package --version 0.1.0 --output <absolute-empty-directory>\n');
  process.exitCode = 2;
}

function parseArguments(args) {
  if (args.length !== 4 || args[0] !== '--version' || args[2] !== '--output') {
    throw new TypeError('expected exactly --version 0.1.0 --output <absolute-empty-directory>');
  }
  if (args[1] !== VERSION) throw new TypeError(`only version ${VERSION} may be packaged`);
  const output = args[3];
  if (!isAbsolute(output)) throw new TypeError('output must be an absolute directory');
  if (output.split(/[\\/]/).includes('..')) throw new TypeError('output must not contain path traversal');
  return resolve(output);
}

function assertOutsideProject(output) {
  const path = relative(projectRoot, output);
  if (path === '' || (!path.startsWith(`..${sep}`) && path !== '..' && !isAbsolute(path))) {
    throw new TypeError('output must be outside the package working tree');
  }
}

async function createEmptyOutput(output) {
  await mkdir(output, { recursive: true });
  if ((await lstat(output)).isSymbolicLink()) throw new TypeError('output must not be a symbolic link');
  const canonicalOutput = await realpath(output);
  assertOutsideProject(canonicalOutput);
  const contents = await readdir(canonicalOutput);
  if (contents.length !== 0) throw new TypeError('output directory must be empty so stale generated artifacts cannot be packaged');
  return canonicalOutput;
}

function run(command, args, environment = {}) {
  execFileSync(command, args, {
    cwd: projectRoot,
    stdio: 'inherit',
    env: { ...process.env, ...environment },
  });
}

async function sha256File(path) {
  const file = await open(path, 'r');
  const hash = createHash('sha256');
  try {
    for await (const chunk of file.createReadStream()) hash.update(chunk);
  } finally {
    await file.close();
  }
  return hash.digest('hex');
}

function assertSafeArtifactPath(path) {
  if (typeof path !== 'string' || path.length === 0 || path.includes('\\') || path.includes('\0') || isAbsolute(path)) {
    throw new TypeError(`unsafe artifact path: ${String(path)}`);
  }
  if (path.split('/').some((part) => part === '' || part === '.' || part === '..')) {
    throw new TypeError(`unsafe artifact path: ${path}`);
  }
}

/**
 * Sort and verify manifest artifact metadata against exact regular output files.
 * Exported so the multi-artifact manifest contract remains testable even though
 * npm pack intentionally produces exactly one tarball.
 */
export async function normalizeAndValidateManifestArtifacts(output, artifacts) {
  if (!Array.isArray(artifacts)) throw new TypeError('manifest artifacts must be an array');
  const canonicalOutput = await realpath(output);
  const paths = new Set();
  const normalized = [];

  for (const artifact of artifacts) {
    if (artifact === null || typeof artifact !== 'object') throw new TypeError('invalid manifest artifact');
    const { path, sha256, size_bytes: sizeBytes } = artifact;
    assertSafeArtifactPath(path);
    if (typeof sha256 !== 'string' || !/^[a-f0-9]{64}$/.test(sha256)) {
      throw new TypeError(`invalid SHA-256 for artifact: ${path}`);
    }
    if (!Number.isSafeInteger(sizeBytes) || sizeBytes < 0) throw new TypeError(`invalid size for artifact: ${path}`);
    if (paths.has(path)) throw new TypeError(`duplicate artifact path: ${path}`);
    paths.add(path);

    const artifactPath = resolve(canonicalOutput, ...path.split('/'));
    const outputRelativePath = relative(canonicalOutput, artifactPath);
    if (outputRelativePath.startsWith(`..${sep}`) || outputRelativePath === '..' || isAbsolute(outputRelativePath)) {
      throw new TypeError(`unsafe artifact path: ${path}`);
    }
    const metadata = await lstat(artifactPath);
    if (!metadata.isFile() || metadata.isSymbolicLink()) {
      throw new TypeError(`manifest artifact is not a regular file: ${path}`);
    }
    const canonicalArtifactPath = await realpath(artifactPath);
    const canonicalRelativePath = relative(canonicalOutput, canonicalArtifactPath);
    if (canonicalRelativePath.startsWith(`..${sep}`) || canonicalRelativePath === '..' || isAbsolute(canonicalRelativePath)) {
      throw new TypeError(`unsafe artifact path: ${path}`);
    }
    if (metadata.size !== sizeBytes) throw new TypeError(`size does not match artifact: ${path}`);
    if (await sha256File(artifactPath) !== sha256) throw new TypeError(`SHA-256 does not match artifact: ${path}`);
    normalized.push({ path, sha256, size_bytes: sizeBytes });
  }

  return normalized.sort((left, right) => Buffer.compare(Buffer.from(left.path), Buffer.from(right.path)));
}

async function regularArtifacts(output) {
  const entries = await readdir(output, { withFileTypes: true });
  const artifacts = [];
  for (const entry of entries) {
    if (!entry.isFile()) {
      throw new TypeError(`packaging output contains a non-regular artifact: ${entry.name}`);
    }
    if (entry.name === 'manifest.json') continue;
    const path = resolve(output, entry.name);
    const metadata = await stat(path);
    artifacts.push({ path: entry.name, sha256: await sha256File(path), size_bytes: metadata.size });
  }
  const normalized = await normalizeAndValidateManifestArtifacts(output, artifacts);
  if (normalized.length !== 1 || !normalized[0].path.endsWith('.tgz')) {
    throw new TypeError('npm pack must produce exactly one tarball artifact');
  }
  return normalized;
}

async function writeManifestAtomically(output, artifacts) {
  const manifest = `${JSON.stringify({ schema_version: 1, language: 'node', version: VERSION, artifacts }, null, 2)}\n`;
  const temporary = resolve(output, `.manifest-${process.pid}-${randomBytes(8).toString('hex')}.tmp`);
  try {
    const file = await open(temporary, 'wx');
    try {
      await file.writeFile(manifest, 'utf8');
    } finally {
      await file.close();
    }
    await rename(temporary, resolve(output, 'manifest.json'));
  } finally {
    await rm(temporary, { force: true });
  }
}

export async function packageArtifact(args = process.argv.slice(2)) {
  const requestedOutput = parseArguments(args);
  assertOutsideProject(requestedOutput);
  const output = await createEmptyOutput(requestedOutput);

  // Keep this explicit rather than invoking this package script through npm. The
  // guard lets its own end-to-end contract test verify the produced artifact without
  // recursively starting another package preparation run.
  run('npm', ['ci']);
  run('npm', ['run', 'verify:compatibility']);
  run('npm', ['audit', '--omit=dev']);
  run('npm', ['audit']);
  run('npm', ['run', 'check:approved-outdated']);
  run('npm', ['test'], { CEKAT_PACKAGE_VALIDATION: '1' });
  run('npm', ['run', 'typecheck']);
  run('npm', ['run', 'build']);
  run('npm', ['run', 'check:exports']);
  run('npm', ['run', 'test:browser']);
  run('npm', ['pack', '--json', '--pack-destination', output]);

  const artifacts = await regularArtifacts(output);
  await writeManifestAtomically(output, artifacts);
  return { output, artifacts };
}

if (process.argv[1] === fileURLToPath(import.meta.url)) {
  packageArtifact().then(({ output }) => {
    process.stdout.write(`Prepared unpublished ${VERSION} package artifacts in ${output}\n`);
  }).catch((error) => {
    usage(error instanceof Error ? error.message : String(error));
  });
}
