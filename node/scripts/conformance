#!/bin/sh
set -eu
[ "$#" -eq 0 ] || { echo "conformance accepts no positional arguments" >&2; exit 2; }
required_env='CEKAT_CONFORMANCE_BASE_URL CEKAT_CONFORMANCE_CONTROL_URL CEKAT_CONFORMANCE_ACCESS_TOKEN CEKAT_CONFORMANCE_FIXTURES'
for name in $required_env; do
  eval "value=\${$name-}"
  [ -n "$value" ] || { echo "$name is required" >&2; exit 2; }
done
for name in $(env | sed -n 's/^\(CEKAT_CONFORMANCE_[^=]*\)=.*/\1/p'); do
  case " $required_env " in *" $name "*) ;; *) echo "unrecognized conformance environment variable: $name" >&2; exit 2 ;; esac
done
validate_origin() {
  node -e '
const [value, name] = process.argv.slice(1);
try {
  const url = new URL(value);
  if (!/^https?:$/.test(url.protocol) || !url.hostname || url.username || url.password || url.pathname !== "/" || url.search || url.hash) throw new Error();
} catch { console.error(`${name} must be an absolute pathless HTTP(S) origin`); process.exit(2); }
' "$1" "$2"
}
validate_origin "$CEKAT_CONFORMANCE_BASE_URL" CEKAT_CONFORMANCE_BASE_URL
validate_origin "$CEKAT_CONFORMANCE_CONTROL_URL" CEKAT_CONFORMANCE_CONTROL_URL
case "$CEKAT_CONFORMANCE_FIXTURES" in /*) ;; *) echo 'CEKAT_CONFORMANCE_FIXTURES must be absolute' >&2; exit 2;; esac
[ -d "$CEKAT_CONFORMANCE_FIXTURES" ] && [ -r "$CEKAT_CONFORMANCE_FIXTURES" ] || { echo 'CEKAT_CONFORMANCE_FIXTURES must be an absolute readable directory' >&2; exit 2; }
# CEKAT_NODE_RUNTIME selects the JavaScript runtime that executes the SDK: node (default) or bun.
# Dependency installation, builds, and type checks always use Node.js and npm.
runtime=${CEKAT_NODE_RUNTIME:-node}
case "$runtime" in
  node) ;;
  bun) command -v bun >/dev/null 2>&1 || { echo 'CEKAT_NODE_RUNTIME=bun requires bun on PATH' >&2; exit 2; } ;;
  *) echo "CEKAT_NODE_RUNTIME must be node or bun, not $runtime" >&2; exit 2 ;;
esac
cd "$(dirname "$0")/.."
npm ci
npm run build
npm run typecheck
if [ "$runtime" = bun ]; then
  exec bun --bun ./node_modules/vitest/vitest.mjs run test/conformance/sdk.test.ts
fi
exec npx vitest run test/conformance/sdk.test.ts
