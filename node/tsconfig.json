{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["node", "express", "koa"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["vitest.config.ts", "playwright.config.ts", "src/node/**/*.ts", "src/integrations/**/*.ts", "src/browser/**/*.ts", "test/**/*.ts"]
}
