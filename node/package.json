{
  "name": "@cekat/event-sdk",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "overrides": {
    "multer": "2.3.0"
  },
  "engines": {
    "node": ">=22.12.0 <28.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./express": {
      "types": "./dist/integrations/express.d.ts",
      "default": "./dist/integrations/express.js"
    },
    "./fastify": {
      "types": "./dist/integrations/fastify.d.ts",
      "default": "./dist/integrations/fastify.js"
    },
    "./koa": {
      "types": "./dist/integrations/koa.d.ts",
      "default": "./dist/integrations/koa.js"
    },
    "./nestjs": {
      "types": "./dist/integrations/nestjs.d.ts",
      "default": "./dist/integrations/nestjs.js"
    },
    "./nextjs": {
      "types": "./dist/integrations/nextjs.d.ts",
      "default": "./dist/integrations/nextjs.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./browser/axios": {
      "types": "./dist/browser/axios.d.ts",
      "default": "./dist/browser/axios.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.browser.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json && node scripts/check-browser-boundary.mjs",
    "test": "node --test test/compatibility/verify-compatibility.test.mjs test/package/package-script.test.mjs && vitest run",
    "test:browser": "playwright test --pass-with-no-tests",
    "test:conformance": "vitest run test/conformance/sdk.test.ts",
    "check:exports": "node scripts/check-exports.mjs",
    "verify:compatibility": "node scripts/verify-compatibility.mjs",
    "check:approved-outdated": "node scripts/check-approved-outdated.mjs",
    "check:browser-boundary": "node scripts/check-browser-boundary.mjs"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/platform-express": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/platform-fastify": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "axios": "^1.0.0",
    "express": "^4.17.0 || ^5.0.0",
    "fastify": "^4.0.0 || ^5.0.0",
    "koa": "^2.13.0 || ^3.0.0",
    "next": "^14.0.0 || ^15.0.0 || ^16.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@nestjs/platform-express": {
      "optional": true
    },
    "@nestjs/platform-fastify": {
      "optional": true
    },
    "axios": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "koa": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/koa": "3.0.3",
    "@types/node": "22.20.2",
    "@vitest/coverage-v8": "5.0.0",
    "ajv": "8.20.0",
    "axios": "1.20.0",
    "express": "5.2.1",
    "fastify": "5.12.4",
    "jsdom": "26.1.0",
    "koa": "3.2.1",
    "next": "16.3.4",
    "playwright": "1.63.0",
    "semver": "7.8.5",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
